From 0deb18768ab9a20a89d09282b002529fb24ee5ae Mon Sep 17 00:00:00 2001
From: Creeper23456 <Creeper23456@outlook.com>
Date: Mon, 16 Nov 2026 11:30:44 +0800
Subject: [PATCH 4/7] venus: exclude sync-file waits on Windows

---
 src/virtio/vulkan/vn_sync.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/virtio/vulkan/vn_sync.c b/src/virtio/vulkan/vn_sync.c
index b5f71bb..a16198a 100644
--- a/src/virtio/vulkan/vn_sync.c
+++ b/src/virtio/vulkan/vn_sync.c
@@ -16,6 +16,18 @@
 #include "vn_renderer.h"
 #include "vn_wsi.h"
 
+#ifdef _WIN32
+/* Windows has no sync files. vn_sync_valid_fd only accepts -1, an object that has already
+ * signaled, so the wait below is never reached with an fd >= 0. */
+static inline int
+sync_wait(int fd, int timeout)
+{
+   (void)fd;
+   (void)timeout;
+   return 0;
+}
+#endif
+
 static void
 vn_sync_payload_release_internal(struct vn_device *dev,
                                  struct vn_sync_payload *payload,
@@ -252,10 +264,15 @@ out_stack_arr_fini:
 static inline bool
 vn_sync_valid_fd(int fd)
 {
+#ifdef _WIN32
+   /* -1 only: there are no sync file descriptors on Windows. */
+   return fd == -1;
+#else
    /* the special value -1 for fd is treated like a valid sync file descriptor
     * referring to an object that has already signaled
     */
    return (fd >= 0 && sync_valid_fd(fd)) || fd == -1;
+#endif
 }
 
 VKAPI_ATTR VkResult VKAPI_CALL
