# SPDX-License-Identifier: GPL-3.0-or-later
#
# Everything the Venus guest build depends on, in one place. Sourced by build.sh.

# Mesa, the base the patches in ../patches apply to (tag mesa-26.3.0). Meson fetches the wrapped
# subprojects (venus-protocol v1.1.3, DirectX-Headers v1.619.1, zlib 1.3.1) at the revisions that
# this commit's own subprojects/*.wrap files name.
MESA_URL=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_REV=0a6fa60abb737d26ac8a316a4aad7c9ddf64f9e4

# LLVM tools (clang-cl, lld, llvm-lib, llvm-rc). The build was done with Debian's 19.1.7.
LLVM_MAJOR=19

# Python packages for meson, installed into a virtual environment (uv if present, else venv).
MESON_VERSION=1.12.1
PY_PACKAGES="meson==1.12.1 mako==1.4.3 markupsafe==3.0.4 packaging==26.3 ply==3.11 pyyaml==6.0.3 setuptools==84.2.1"

# The MSVC CRT and Windows SDK come from Microsoft's public Visual Studio 18 channel through xwin.
# The versions are the ones the DLL was built against: MSVC 14.52 (cl 19.52.37029, directory
# 14.52.37025 in a Visual Studio install) and SDK 10.0.26100.
XWIN_VERSION=0.10.0
VS_MANIFEST_VERSION=18
CRT_VERSION=14.52
SDK_VERSION=10.0.26100

# SHA-256 of the import libraries the link reads from the CRT and the SDK, taken from the
# sysroot the published DLL was built with. The CRT ones are byte-identical to the public
# Microsoft.VC.14.52.CRT.x64.Desktop.base package. build.sh checks them after unpacking.
# Format: sha256, two spaces, path relative to the MSVC lib/x64 or the SDK Lib/<version> directory.
CRT_LIB_SHA256="
e61d5927b64d5448675b403b3cb43c33ae737237408cc18a8944da3d27b8acdb  msvcrt.lib
12d4d6b34cf13c22371ce765877fb746b545c01fff4747ea085f772cdc0ba048  oldnames.lib
33036728ad5962dad8e28737d7c813790e760c17058765c9ac83bc9ed6a09793  msvcprt.lib
54707f836c459a6bab635ca0f91f46f25bab88559b40c6d69ed36c7a1563481b  vcruntime.lib
"
SDK_LIB_SHA256="
7ef4eac926bf597d2f243f16cdfed7e0db22cb3ca34a1d7e088a84c994a03d66  ucrt/x64/ucrt.lib
842f5ce7ad8cf5aab7491b791e7968d2be510ae93f4019d3311797289399d221  um/x64/kernel32.Lib
"
